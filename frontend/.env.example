# ==============================================================================
# Mor-Finance Developer Academy — Frontend Environment Configuration
# ==============================================================================

# GitHub OAuth App Client ID (Optional, defaults to configured OAuth App if unset)
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173

# ------------------------------------------------------------------------------
# Transak On-Ramp Integration (https://dashboard.transak.com)
# ------------------------------------------------------------------------------
# 1. Sign in to https://dashboard.transak.com
# 2. Select Staging (for testnets) or Production (for mainnet) from the top-right
# 3. Copy your "API Key" from the "Developers" tab on the left
# 4. Paste it below:
VITE_TRANSAK_API_KEY=

# Transak Environment: 'STAGING' (for testnets) or 'PRODUCTION' (for mainnet)
VITE_TRANSAK_ENV=STAGING

# ------------------------------------------------------------------------------
# Subscription checkout (Paystack / Flutterwave inline widgets)
# ------------------------------------------------------------------------------
# PUBLIC keys only — never put a secret key in a VITE_ variable (they ship to the browser).
# The values below are the TEST-mode keys of the sandbox accounts; replace them with the
# client's own keys. On localhost, open /subscriptions?simulate=1 to try the flow with no keys.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_66c71bf73ecd58b71385a9d99055f4d6b13625d9
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-c7f342d8e67167277dc7aec61e0fdac3-X
